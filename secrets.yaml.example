# WLAN-Router muss auf diesem 2,4-GHz-Kanal senden.
wifi_ssid: "MEIN_WLAN"
wifi_password: "BITTE_AENDERN"
wifi_channel: 1

ota_password: "BITTE_EIN_LANGES_OTA_PASSWORT_SETZEN"
web_username: "ofen"
web_password: "BITTE_EIN_LANGES_WEB_PASSWORT_SETZEN"

# Später für Push-Nachrichten verwendet.
ntfy_topic: "BITTE_EIN_ZUFAELLIGES_TOPIC_SETZEN"

# Gemeinsamer Schlüssel für packet_transport; beliebige lange Zufallsphrase.
transport_key: "BITTE_EINEN_LANGEN_ZUFAELLIGEN_TRANSPORTSCHLUESSEL_SETZEN"

# WLAN-MAC-Adressen der beiden ESP32, in Großbuchstaben.
display_mac: "AA:BB:CC:DD:EE:01"
raumfuehler_mac: "AA:BB:CC:DD:EE:02"

